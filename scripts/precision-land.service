[Unit]
Description=Precision-Land Autonomous Drone Stack (Raspberry Pi AI Camera IMX500, ArUco Vision, MAVLink, RTSP)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jech
WorkingDirectory=/home/jech/Precision-land
Environment=PYTHONUNBUFFERED=1
Environment=MAVLINK20=1
Environment=JECH_MAVLINK_CONNECT=udpin:127.0.0.1:14555
Environment=JECH_MAVLINK_BAUD=921600
Environment=JECH_VFLIP=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Hardware focus lock is not needed on fixed/auto-focus IMX500
ExecStart=/home/jech/Precision-land/scripts/run_precision_land_tmux.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
